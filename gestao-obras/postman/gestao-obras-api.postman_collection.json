                "{{obraId}}",
                "relatorios"
              ]
            },
            "description": "O corpo é enviado como texto puro (`Content-Type: text/plain`), mas o endpoint só aceita JSON (`@Consumes(APPLICATION_JSON)`) → **415 Unsupported Media Type**.\n\n- `Content-Type`: o formato do que o cliente **envia**.\n- `Accept`: o formato que o cliente quer **receber** (veja o 406).",
            "body": {
              "mode": "raw",
              "raw": "Relatório em texto puro"
            }
