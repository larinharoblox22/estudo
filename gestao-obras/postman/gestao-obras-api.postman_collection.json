                  "    pm.response.to.have.status(415);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir obra pela API → 405",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/obras/{{obraId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "obras",
                "{{obraId}}"
              ]
            },
            "description": "As obras são **somente leitura** na API → **405 Method Not Allowed**.\n\nO próprio JAX-RS responde: a URL existe, mas não aceita esse método. O header **Allow** lista os métodos permitidos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 405 Method Not Allowed\", function () {",
                  "    pm.response.to.have.status(405);",
                  "});",
                  "pm.test(\"Header Allow lista só métodos de leitura\", function () {",
                  "    const allow = pm.response.headers.get(\"Allow\");",
                  "    pm.expect(allow).to.include(\"GET\");",
                  "    pm.expect(allow).to.not.include(\"DELETE\");",
                  "});"
                ]
              }
            }
          ]
