<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.exemplo</groupId>
    <artifactId>gestao-obras</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <!-- WAR: o artefato é implantado em um servidor de aplicação (WildFly/Payara),
         ao contrário do JAR "fat" executável do Spring Boot. -->
    <packaging>war</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Guarda o nome real dos parâmetros dos métodos no .class (javac -parameters):
             as mensagens de validação da API mostram "dados" em vez de "arg1". -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.version>10.0.0</jakartaee.version>
        <!-- Servidor usado pelo profile "wildfly" (mvnw -Pwildfly package wildfly:run). -->
        <wildfly.versao>35.0.1.Final</wildfly.versao>
        <wildfly.home>${project.build.directory}/wildfly-${wildfly.versao}</wildfly.home>
    </properties>

    <dependencies>
        <!-- API completa do Jakarta EE 10 (JPA, EJB, CDI, JSF, JAX-RS, Bean Validation).
             "provided": as implementações já existem no servidor de aplicação,
             por isso não são empacotadas no WAR. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Biblioteca de componentes JSF. Ao contrário das APIs Jakarta EE, não vem
             com o servidor: é empacotada no WAR (escopo compile). O classificador
             "jakarta" seleciona a versão para o namespace jakarta.* (Faces 4). -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>15.0.18</version>
            <classifier>jakarta</classifier>
        </dependency>
    </dependencies>

    <build>
        <finalName>gestao-obras</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- wildfly:run inicia o WildFly que está em ${wildfly.home}, implanta o WAR
                 e mostra o log no terminal (Ctrl+C para parar). -->
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>5.1.5.Final</version>
                <configuration>
                    <jbossHome>${wildfly.home}</jbossHome>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Executar a aplicação sem instalar nada à mão:
                 mvnw -Pwildfly package wildfly:run        (Windows: mvnw.cmd ...)
             Na fase "package", baixa do Maven Central a distribuição oficial do WildFly
             (só na primeira vez; depois fica no cache ~/.m2) e a descompacta em target/.
             Depois abra http://localhost:8080/gestao-obras/ -->
        <profile>
            <id>wildfly</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>baixar-wildfly</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.wildfly</groupId>
                                            <artifactId>wildfly-dist</artifactId>
                                            <version>${wildfly.versao}</version>
                                            <type>zip</type>
                                            <outputDirectory>${project.build.directory}</outputDirectory>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
